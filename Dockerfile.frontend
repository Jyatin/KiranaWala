FROM node:20-alpine

WORKDIR /app

# Install the locked root dependencies used by the current Next.js application.
COPY package.json package-lock.json ./
RUN npm ci

# Copy the Next.js app and its static assets (not the legacy public-only image).
COPY . .

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
EXPOSE 3000

RUN npm run build

CMD ["npm", "start"]
