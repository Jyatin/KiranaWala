# ============================================================
# KiranaWala Frontend (Next.js) — Environment Variables Template
#
# Copy this file to .env.local and configure your environment.
# ============================================================

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Razorpay Key ID for client-side checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
