# ============================================================
# KiranaWala Server — Environment Variables Template
#
# Copy this file to .env and supply your local or production values.
# NEVER commit .env with real credentials to source control.
# ============================================================

# Runtime Environment (development | test | production)
NODE_ENV=development

# Server Port (defaults to 3000)
PORT=3000

# Frontend URL (for CORS allowlist in production)
FRONTEND_URL=http://localhost:3001

# MongoDB Connection String (Required)
# Development local fallback: mongodb://127.0.0.1:27017/kiranawala
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb://127.0.0.1:27017/kiranawala

# JWT Signing Secret (Required — Minimum 32 characters in production)
# In production, startup will fail fast if missing or shorter than 32 characters.
JWT_SECRET=your_minimum_32_character_random_jwt_signing_secret_here

# JWT Expiration Duration (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h

# ============================================================
# Razorpay Payment Gateway & Webhook Credentials
# ============================================================
# For local development without live keys, MockPaymentProvider is automatically used.
# In production, missing credentials will block payment operations.
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_min_32_chars

# ============================================================
# AI Shopping Assistant (Google Gemini)
# ============================================================
# Obtain key from: https://aistudio.google.com/app/apikey
# If unset, AI shopping endpoint returns graceful 503 while all commerce works normally.
GEMINI_API_KEY=

# ============================================================
# Demo Data Seeding Safety Overrides
# ============================================================
# Seeding demo accounts is strictly blocked in production by default.
# Set to 'true' only if you explicitly want to create non-production demo personas.
ALLOW_DEMO_SEEDING=false
DEMO_USER_PASSWORD=Password123!
