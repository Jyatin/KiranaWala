# KiranaWala Server — Environment Variables
#
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to source control.
# server/.env is already in .gitignore.

# MongoDB connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=KiranaWala

# JWT signing secret (required — use a long random string in production)
JWT_SECRET=your-jwt-secret-here

# Server port (optional, defaults to 3000)
PORT=3000

# ============================================================
# AI Provider Configuration — Day 6 Part 1
# ============================================================

# Google Gemini API key
# Obtain from: https://aistudio.google.com/app/apikey
# Required for: POST /api/customer/ai/chat
# If absent: the AI endpoint returns 503; all other APIs continue normally
# NEVER put the real key here — this file IS committed to source control
GEMINI_API_KEY=

# ============================================================
# Razorpay Payments (optional in local development)
# ============================================================

# Leave unset to use the non-production mock provider.
# Real payment integration requires both the key ID and key secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required to verify incoming Razorpay webhooks.
# Configure the same secret in the Razorpay dashboard webhook settings.
RAZORPAY_WEBHOOK_SECRET=
